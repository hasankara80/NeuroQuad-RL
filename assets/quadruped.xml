<mujoco model="mini_spot">
    <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
    <option gravity="0 0 -9.81" timestep="0.01"/>

    <asset>
        <!-- Custom grid floor texture -->
        <texture type="2d" name="grid" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="512" height="512"/>
        <material name="mat_floor" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0.2"/>

        <!-- Boston Dynamics Colors -->
        <material name="mat_torso" rgba="0.9 0.7 0.1 1"/>
        <material name="mat_leg" rgba="0.1 0.1 0.1 1"/>
    </asset>

    <worldbody>
        <!-- Dynamic Lighting and Shadows -->
        <light pos="0 0 5" dir="0 0 -1" directional="true" castshadow="true"/>
        <geom name="floor" type="plane" size="10 10 0.1" material="mat_floor" friction="1.0 0.005 0.0001"/>

        <!-- MAIN TORSO -->
        <body name="torso" pos="0 0 0.3">
            <freejoint name="root"/>
            <geom name="torso_geom" type="box" size="0.2 0.1 0.05" mass="5.0" material="mat_torso"/>

            <!-- FRONT LEFT LEG -->
            <body name="fl_thigh" pos="0.2 0.1 0">
                <joint name="fl_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom type="capsule" size="0.02" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                <body name="fl_calf" pos="0 0 -0.15">
                    <joint name="fl_knee" type="hinge" axis="0 1 0" range="-1.5 0.0"/>
                    <geom type="capsule" size="0.015" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                </body>
            </body>

            <!-- FRONT RIGHT LEG -->
            <body name="fr_thigh" pos="0.2 -0.1 0">
                <joint name="fr_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom type="capsule" size="0.02" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                <body name="fr_calf" pos="0 0 -0.15">
                    <joint name="fr_knee" type="hinge" axis="0 1 0" range="-1.5 0.0"/>
                    <geom type="capsule" size="0.015" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                </body>
            </body>

            <!-- BACK LEFT LEG -->
            <body name="bl_thigh" pos="-0.2 0.1 0">
                <joint name="bl_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom type="capsule" size="0.02" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                <body name="bl_calf" pos="0 0 -0.15">
                    <joint name="bl_knee" type="hinge" axis="0 1 0" range="-1.5 0.0"/>
                    <geom type="capsule" size="0.015" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                </body>
            </body>

            <!-- BACK RIGHT LEG -->
            <body name="br_thigh" pos="-0.2 -0.1 0">
                <joint name="br_hip" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
                <geom type="capsule" size="0.02" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                <body name="br_calf" pos="0 0 -0.15">
                    <joint name="br_knee" type="hinge" axis="0 1 0" range="-1.5 0.0"/>
                    <geom type="capsule" size="0.015" fromto="0 0 0 0 0 -0.15" material="mat_leg"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Swapped from raw torque <motor> to PD position control <position> -->
        <position name="fl_hip_motor" joint="fl_hip" kp="30"/>
        <position name="fl_knee_motor" joint="fl_knee" kp="30"/>
        <position name="fr_hip_motor" joint="fr_hip" kp="30"/>
        <position name="fr_knee_motor" joint="fr_knee" kp="30"/>
        <position name="bl_hip_motor" joint="bl_hip" kp="30"/>
        <position name="bl_knee_motor" joint="bl_knee" kp="30"/>
        <position name="br_hip_motor" joint="br_hip" kp="30"/>
        <position name="br_knee_motor" joint="br_knee" kp="30"/>
    </actuator>
</mujoco>